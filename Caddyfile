{$DOMAIN} {
	encode zstd gzip

	# API и вебхук бота уходят в приложение
	handle /api/* {
		reverse_proxy app:8000
	}
	handle /tg/* {
		reverse_proxy app:8000
	}

	# Всё остальное — статика Mini App (SPA: неизвестные пути отдают index.html)
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server

		# Ассеты с хешем в имени можно кэшировать вечно
		@hashed path_regexp ^/assets/
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		# Приватное приложение: в поисковой выдаче ему не место
		X-Robots-Tag "noindex, nofollow, noarchive"
		# Открывать во фрейме разрешаем только Telegram — это и есть Mini App
		Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors https://web.telegram.org https://telegram.org; base-uri 'none'; form-action 'none'; object-src 'none'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Ни версии сервера, ни признаков того, что внутри
		-Server
	}
}
