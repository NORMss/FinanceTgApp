{$DOMAIN} {
	encode zstd gzip

	# API и вебхук бота уходят в приложение
	handle /api/* {
		reverse_proxy app:8000
	}
	handle /tg/* {
		reverse_proxy app:8000
	}

	# Всё остальное — статика Mini App (SPA: неизвестные пути отдают index.html)
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server

		# Ассеты с хешем в имени можно кэшировать вечно
		@hashed path_regexp ^/assets/
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Mini App открывается внутри Telegram — фрейм должен быть разрешён
		-Server
	}
}
