# Как ходим в приложение. Сниппет объявляется до сайта — Caddy читает файл целиком,
# но так его видно раньше, чем использование.
(app_upstream) {
	reverse_proxy app:8000 {
		# Контейнер приложения переживает перезапуски: обновление, миграции, OOM.
		# Порт в это время закрыт, и без повторов Caddy отдаёт 502 сразу — человек
		# видит «Ошибка 502» на том экране, где как раз что-то делал. Повтор ждёт
		# приложение вместо него: запрос подвиснет на секунды, но дойдёт.
		#
		# Повторяются только запросы, из которых наверх ещё ничего не ушло, — то есть
		# именно случай «не удалось подключиться». Запрос, который приложение приняло
		# и не осилило, повторно не отправляется.
		lb_try_duration 20s
		lb_try_interval 500ms

		transport http {
			# Кто открыл соединение, тот его и закрывает. Приложение держит
			# простаивающее соединение 65с (--timeout-keep-alive в Dockerfile),
			# здесь — 30с: значит первым его всегда закрывает Caddy. Иначе бывает
			# гонка, когда запрос уходит в соединение, которое приложение уже
			# закрыло, и на ровном месте получается 502.
			keepalive 30s
			keepalive_idle_conns 16
			dial_timeout 5s
		}
	}
}

{$DOMAIN} {
	encode zstd gzip

	# API и вебхук бота уходят в приложение.
	#
	# Настройки одинаковы для обоих путей, поэтому вынесены в сниппет выше: правка
	# в одном месте не разъедется с другим.
	handle /api/* {
		import app_upstream
	}
	handle /tg/* {
		import app_upstream
	}

	# Всё остальное — статика Mini App (SPA: неизвестные пути отдают index.html)
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server

		# Ассеты с хешем в имени можно кэшировать вечно
		@hashed path_regexp ^/assets/
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		# Приватное приложение: в поисковой выдаче ему не место
		X-Robots-Tag "noindex, nofollow, noarchive"
		# Открывать во фрейме разрешаем только Telegram — это и есть Mini App
		Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors https://web.telegram.org https://telegram.org; base-uri 'none'; form-action 'none'; object-src 'none'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Ни версии сервера, ни признаков того, что внутри
		-Server
	}
}
