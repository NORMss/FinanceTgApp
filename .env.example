# ---------- Telegram ----------
# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF...
# Публичный HTTPS-адрес Mini App (он же используется для вебхука).
# Локально: адрес туннеля, например https://xxx.trycloudflare.com
PUBLIC_URL=https://finance.example.com

# Домен для Caddy: по нему автоматически выпускается сертификат Let's Encrypt.
# Только имя хоста — без https:// и без порта. Должен совпадать с доменом в PUBLIC_URL.
# Сертификат на IP-адрес выпустить нельзя, нужна A-запись домен -> IP сервера.
# Для локальной проверки без TLS: DOMAIN=:80
DOMAIN=finance.example.com

# Только для режима «за чужим прокси» (docker-compose.behind-proxy.yml):
# локальный порт, который приложение занимает на 127.0.0.1
APP_PORT=8000

# Только для режима «прокси в контейнере» (docker-compose.shared-net.yml):
# имя существующей docker-сети, в которой работает чужой Caddy/nginx.
# Посмотреть: docker network ls
PROXY_NETWORK=web
# ID пользователей, которым разрешён доступ. Через запятую. ОБЯЗАТЕЛЬНО заполнить.
ALLOWED_TELEGRAM_IDS=111111111,222222222
# Режим получения апдейтов: webhook (прод) или polling (локальная разработка)
BOT_MODE=polling
# Секрет для заголовка X-Telegram-Bot-Api-Secret-Token (только для webhook)
WEBHOOK_SECRET=change-me-random-string

# ---------- Приложение ----------
# Секрет для подписи сессионных JWT. openssl rand -hex 32
JWT_SECRET=change-me-please-32-bytes-minimum
# Валюта по умолчанию (ISO 4217)
BASE_CURRENCY=RUB
LOG_LEVEL=INFO
# Разрешить фронту работать без Telegram (только для локальной разработки!)
DEV_AUTH_BYPASS=false
DEV_TELEGRAM_ID=111111111

# ---------- Защита ----------
# Подробности отказа в доступе в ответе API. В норме выключено: постороннему незачем
# знать, дело в подписи, в белом списке или в часах сервера. Причина всегда в логах.
# Включайте временно, когда настраиваете сервер: DEBUG_ERRORS=true
DEBUG_ERRORS=false
# Swagger и схема API на /api/docs. Для приватного приложения это карта всех ручек.
ENABLE_DOCS=false
# Сколько неудачных попыток входа с одного адреса терпим и за какое окно (секунды)
LOGIN_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300
# Брать адрес клиента из X-Forwarded-For. true — когда снаружи стоит ваш прокси
# (Caddy/nginx). Поставьте false, если приложение опубликовано в интернет напрямую:
# иначе заголовок можно подделать и обойти ограничение попыток входа.
TRUST_PROXY_HEADER=true

# ---------- База ----------
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ---------- Google Sheets ----------
SHEETS_ENABLED=false
# Путь к JSON-ключу сервис-аккаунта внутри контейнера
GOOGLE_CREDENTIALS_FILE=./data/google-credentials.json
# ID таблицы из её URL: docs.google.com/spreadsheets/d/<ЭТО_ОН>/edit
GOOGLE_SPREADSHEET_ID=
# Как часто выгружать накопленные изменения, секунды
SHEETS_SYNC_INTERVAL=60
