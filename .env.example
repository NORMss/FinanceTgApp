# ---------- Telegram ----------
# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF...
# Публичный HTTPS-адрес Mini App (он же используется для вебхука).
# Локально: адрес туннеля, например https://xxx.trycloudflare.com
PUBLIC_URL=https://finance.example.com
# ID пользователей, которым разрешён доступ. Через запятую. ОБЯЗАТЕЛЬНО заполнить.
ALLOWED_TELEGRAM_IDS=111111111,222222222
# Режим получения апдейтов: webhook (прод) или polling (локальная разработка)
BOT_MODE=polling
# Секрет для заголовка X-Telegram-Bot-Api-Secret-Token (только для webhook)
WEBHOOK_SECRET=change-me-random-string

# ---------- Приложение ----------
# Секрет для подписи сессионных JWT. openssl rand -hex 32
JWT_SECRET=change-me-please-32-bytes-minimum
# Валюта по умолчанию (ISO 4217)
BASE_CURRENCY=RUB
LOG_LEVEL=INFO
# Разрешить фронту работать без Telegram (только для локальной разработки!)
DEV_AUTH_BYPASS=false
DEV_TELEGRAM_ID=111111111

# ---------- База ----------
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ---------- Google Sheets ----------
SHEETS_ENABLED=false
# Путь к JSON-ключу сервис-аккаунта внутри контейнера
GOOGLE_CREDENTIALS_FILE=./data/google-credentials.json
# ID таблицы из её URL: docs.google.com/spreadsheets/d/<ЭТО_ОН>/edit
GOOGLE_SPREADSHEET_ID=
# Как часто выгружать накопленные изменения, секунды
SHEETS_SYNC_INTERVAL=60
